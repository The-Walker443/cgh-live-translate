# Vorlage fuer die Bereitstellung per Docker Compose.
# Kopieren nach .env und ausfuellen:   cp .env.example .env
#
# Diese Datei enthaelt bewusst KEINE echten Werte und ist im Git.
# Die ausgefuellte .env ist durch .gitignore ausgeschlossen.

# --- Image ---------------------------------------------------------------
# Wird von der Action bei jedem Push gebaut. Das Image ist oeffentlich
# abrufbar, eine Anmeldung ist nicht noetig.
IMAGE=ghcr.io/the-walker443/cgh-live-translate:latest

# Port, unter dem die App auf dem Server erreichbar ist.
APP_PORT=8080

# --- LiveKit -------------------------------------------------------------
# Bei LiveKit Cloud:      cloud.livekit.io -> Settings -> Keys
# Bei selbst gehostetem LiveKit: die dort konfigurierten Schluessel.
#
# MERKSATZ: LIVEKIT_URL ist die Adresse aus Sicht des BESUCHER-HANDYS,
# nicht aus Sicht des Servers. Auf der NAS steht dort niemals localhost.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<projekt>.livekit.cloud

# --- Gemini --------------------------------------------------------------
# Key muss aus einem Projekt mit aktivierter Abrechnung (Paid Tier) stammen.
# Free Tier begrenzt gleichzeitige WebSockets auf ca. 3-5 und erlaubt Google
# die Nutzung der Daten zur Produktverbesserung.
GEMINI_API_KEY=

# --- Schutz der Sender-Seite ---------------------------------------------
# Wer die Broadcast-Seite oeffnen will, muss das eingeben.
BROADCAST_PASSWORD=
