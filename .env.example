# Vorlage fuer die Bereitstellung per Docker Compose.
# Kopieren nach .env und ausfuellen:   cp .env.example .env
#
# Diese Datei enthaelt bewusst KEINE echten Werte und ist im Git.
# Die ausgefuellte .env ist durch .gitignore ausgeschlossen.

# --- Image ---------------------------------------------------------------
# Wird von der Action bei jedem Push gebaut. Das Image ist oeffentlich
# abrufbar, eine Anmeldung ist nicht noetig.
IMAGE=ghcr.io/cghersbruck/cgh-live-translate:latest

# --- LiveKit -------------------------------------------------------------
# Selbst gehostetes LiveKit (Dienst "cgh-livekit" in der docker-compose.yml).
#
# Diese beiden Werte muessen mit dem keys-Abschnitt in livekit.yaml
# uebereinstimmen, sonst werden alle Tokens abgelehnt.
# Ein Paar erzeugen:  docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Adresse aus Sicht des BESUCHER-HANDYS. Ueber den Reverse Proxy, mit TLS.
# Niemals localhost und niemals der Containername.
LIVEKIT_URL=wss://livekit.beispiel.de

# Adresse aus Sicht des SERVERS, fuer die Uebersetzer-Bridge im Container.
# Bleibt im Docker-Netz und braucht daher weder TLS noch den Router.
# Nur aendern, wenn LiveKit ausserhalb dieses Stacks laeuft.
LIVEKIT_URL_INTERNAL=ws://cgh-livekit:7880

# Veroeffentlichte Medienports. Beide muessen im Router auf die NAS zeigen,
# wenn Besucher auch von ausserhalb des WLANs zuhoeren sollen.
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# --- Gemini --------------------------------------------------------------
# Key muss aus einem Projekt mit aktivierter Abrechnung (Paid Tier) stammen.
# Free Tier begrenzt gleichzeitige WebSockets auf ca. 3-5 und erlaubt Google
# die Nutzung der Daten zur Produktverbesserung.
GEMINI_API_KEY=

# --- Schutz der Sender-Seite ---------------------------------------------
# Wer die Broadcast-Seite oeffnen will, muss das eingeben.
BROADCAST_PASSWORD=

# --- Sonstiges -----------------------------------------------------------
TZ=Europe/Berlin
